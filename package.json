{
	"name": "kofra-api",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.9",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "node tools/build.mjs",
		"build:check": "node tools/build.mjs --check",
		"lint": "prettier --check . && eslint . && redocly lint generated/openapi.yaml",
		"format": "prettier --write .",
		"test": "node --test \"test/*.test.mjs\"",
		"f7": "node tools/f7/check.mjs",
		"mock": "node tools/mock/server.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@redocly/cli": "2.82.0",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"eslint": "^10.15.0",
		"globals": "^17.14.0",
		"openapi-typescript": "7.13.0",
		"prettier": "^3.10.1",
		"yaml": "2.9.1"
	}
}
